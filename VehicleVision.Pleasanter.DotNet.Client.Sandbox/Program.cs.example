// ============================================================================
// VehicleVision.Pleasanter.DotNet.Client.Sandbox
// ----------------------------------------------------------------------------
// このプロジェクトはデバッグ・動作確認用のサンドボックスです。
//
// 使い方（Copilot併用の場合）:
// 1. sandbox.settings.json.example → sandbox.settings.json にコピー
// 2. sandbox.settings.json に接続情報を設定
// 3. RunTestAsync() 内にテストコードを記述して実行
// 4. Copilotに「このAPIを試して」と依頼すると、コードを生成してくれます
//
// 使い方（対話式メニューの場合）:
// 1. USE_MENU = true に変更
// 2. 実行するとメニューが表示される
//
// 注意:
// - Program.cs と sandbox.settings.json は .gitignore で除外されています
// - APIキーなどの機密情報を誤ってコミットしないよう注意してください
// ============================================================================

using System.Text.Json;
using VehicleVision.Pleasanter.DotNet.Client;
using VehicleVision.Pleasanter.DotNet.Client.Models.Requests.Items;
using VehicleVision.Pleasanter.DotNet.Client.Sandbox;

// ============================================================================
// 実行モード設定
// ============================================================================
// true: 対話式メニューを表示
// false: RunTestAsync() を直接実行（Copilot併用向け）
const bool USE_MENU = false;

// ============================================================================
// 初期化
// ============================================================================
var jsonOptions = new JsonSerializerOptions { WriteIndented = true };

Console.WriteLine("╔══════════════════════════════════════════════════════════════╗");
Console.WriteLine("║         Pleasanter Client Sandbox                           ║");
Console.WriteLine("╚══════════════════════════════════════════════════════════════╝");
Console.WriteLine();

// 設定読み込み
SandboxSettings settings;
try
{
    settings = SettingsLoader.Load();
    Console.WriteLine($"[OK] 設定を読み込みました");
    Console.WriteLine($"     BaseUrl: {settings.Pleasanter.BaseUrl}");
    Console.WriteLine($"     ApiVersion: {settings.Pleasanter.ApiVersion}");
    Console.WriteLine();
}
catch (Exception ex)
{
    Console.WriteLine($"[ERROR] 設定の読み込みに失敗しました:");
    Console.WriteLine($"        {ex.Message}");
    Console.WriteLine();
    Console.WriteLine("sandbox.settings.json.example をコピーして設定を作成してください。");
    return;
}

// クライアントの初期化
using var client = new PleasanterClient(
    settings.Pleasanter.BaseUrl,
    settings.Pleasanter.ApiKey,
    settings.Pleasanter.ApiVersion);

Console.WriteLine($"[OK] クライアントを初期化しました");
Console.WriteLine();

// ============================================================================
// 実行
// ============================================================================
try
{
    if (USE_MENU)
    {
        await RunTestMenuAsync();
    }
    else
    {
        await RunTestAsync();
    }
}
catch (Exception ex)
{
    Console.WriteLine($"[ERROR] エラーが発生しました: {ex.Message}");
    Console.WriteLine(ex.StackTrace);
}

Console.WriteLine();
Console.WriteLine("=== 完了 ===");


// ############################################################################
//
//  テストコード（ここを編集してください）
//
// ############################################################################
//
// 利用可能な変数:
// - client: PleasanterClient インスタンス
// - settings.TestData.SiteId: 設定のサイトID
// - settings.TestData.RecordId: 設定のレコードID
// - jsonOptions: JSON整形用オプション
//
// ヘルパーメソッド:
// - PrintJson(obj): オブジェクトをJSON出力
// - PrintResponse(response): レスポンス情報を出力
//
// ############################################################################

async Task RunTestAsync()
{
    // ========================================
    // ここにテストコードを記述
    // ========================================

    var siteId = settings.TestData.SiteId;
    var recordId = settings.TestData.RecordId;

    Console.WriteLine($"SiteId: {siteId}");
    Console.WriteLine($"RecordId: {recordId}");
    Console.WriteLine();

    // 例: レコード取得
    // var response = await client.GetRecordAsync(recordId, new GetRecordRequest());
    // PrintResponse(response);
    // if (response.Response?.Response is not null)
    // {
    //     PrintJson(response.Response.Response);
    // }

    Console.WriteLine("テストコードをここに追加してください。");
}


// ############################################################################
//  ヘルパーメソッド
// ############################################################################

void PrintJson(object obj)
{
    var json = JsonSerializer.Serialize(obj, jsonOptions);
    Console.WriteLine(json);
}

void PrintResponse<T>(VehicleVision.Pleasanter.DotNet.Client.Models.Responses.ApiResponse<T> response)
{
    Console.WriteLine($"StatusCode: {response.StatusCode}");
    Console.WriteLine($"IsSuccess: {response.IsSuccess}");
    Console.WriteLine($"Message: {response.Message ?? "(null)"}");
}


// ############################################################################
//  対話式テストメニュー
// ############################################################################

async Task RunTestMenuAsync()
{
    while (true)
    {
        Console.WriteLine("──────────────────────────────────────────────────────────────");
        Console.WriteLine("テストメニュー:");
        Console.WriteLine("  1. レコード取得 (単一)");
        Console.WriteLine("  2. レコード一覧取得");
        Console.WriteLine("  3. サイト情報取得");
        Console.WriteLine("  4. ユーザ一覧取得");
        Console.WriteLine("  0. 終了");
        Console.WriteLine("──────────────────────────────────────────────────────────────");
        Console.Write("選択 > ");

        var input = Console.ReadLine()?.Trim();

        switch (input)
        {
            case "1":
                await TestGetRecordAsync();
                break;
            case "2":
                await TestGetRecordsAsync();
                break;
            case "3":
                await TestGetSiteAsync();
                break;
            case "4":
                await TestGetUsersAsync();
                break;
            case "0":
            case "":
                return;
            default:
                Console.WriteLine("[WARN] 無効な選択です");
                break;
        }
        Console.WriteLine();
    }
}

async Task TestGetRecordAsync()
{
    var recordId = settings.TestData.RecordId;
    if (recordId == 0)
    {
        Console.Write("レコードIDを入力: ");
        _ = long.TryParse(Console.ReadLine(), out recordId);
    }
    var response = await client.GetRecordAsync(recordId, new GetRecordRequest());
    PrintResponse(response);
    if (response.Response?.Response is not null) PrintJson(response.Response.Response);
}

async Task TestGetRecordsAsync()
{
    var siteId = settings.TestData.SiteId;
    if (siteId == 0)
    {
        Console.Write("サイトIDを入力: ");
        _ = long.TryParse(Console.ReadLine(), out siteId);
    }
    var response = await client.GetRecordsAsync(siteId, new GetRecordsRequest());
    PrintResponse(response);
    Console.WriteLine($"TotalCount: {response.Response?.TotalCount}");
    if (response.Response?.Data is not null)
    {
        foreach (var r in response.Response.Data.Take(5))
            Console.WriteLine($"  - {r.ResultId ?? r.IssueId}: {r.Title}");
    }
}

async Task TestGetSiteAsync()
{
    var siteId = settings.TestData.SiteId;
    if (siteId == 0)
    {
        Console.Write("サイトIDを入力: ");
        _ = long.TryParse(Console.ReadLine(), out siteId);
    }
    var response = await client.GetSiteAsync(siteId, new VehicleVision.Pleasanter.DotNet.Client.Models.Requests.Sites.GetSiteRequest());
    PrintResponse(response);
    if (response.Response?.Data is not null) PrintJson(response.Response.Data);
}

async Task TestGetUsersAsync()
{
    var response = await client.GetUsersAsync(new VehicleVision.Pleasanter.DotNet.Client.Models.Requests.Users.GetUsersRequest());
    PrintResponse(response);
    if (response.Response?.Data is not null)
    {
        foreach (var u in response.Response.Data.Take(5))
            Console.WriteLine($"  - {u.UserId}: {u.LoginId} ({u.Name})");
    }
}
