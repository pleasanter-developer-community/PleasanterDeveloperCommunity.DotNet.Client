{
  "scripts": {
    "lint:md": "markdownlint-cli2 \"docs/**/*.md\" \"*.md\"",
    "lint:md:fix": "markdownlint-cli2 --fix \"docs/**/*.md\" \"*.md\"",
    "format": "prettier --write \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"docs/**/*.md\" \"*.md\"",
    "toc": "doctoc docs README.md CONTRIBUTING.md --github --maxlevel 3 --notitle && node docs/script/decode-toc.js",
    "toc:all": "npm run toc && npm run format"
  },
  "devDependencies": {
    "doctoc": "^2.2.1",
    "markdownlint": "^0.40.0",
    "markdownlint-cli2": "^0.20.0",
    "prettier": "^3.5.0"
  }
}
